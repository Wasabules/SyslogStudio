# Normalize line endings to LF for all text so checkouts on Windows/macOS/Linux
# don't churn CRLF<->LF and shell/workflow scripts stay LF.
* text=auto eol=lf

# Explicit binaries (never touch their bytes).
*.png  binary
*.ico  binary
*.icns binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.dmg  binary
*.exe  binary
*.zip  binary
*.gz   binary
*.deb  binary
